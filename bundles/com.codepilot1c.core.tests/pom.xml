<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.codepilot1c</groupId>
        <artifactId>bundles-parent</artifactId>
        <version>1.3.9-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>com.codepilot1c.core.tests</artifactId>
    <packaging>jar</packaging>
    <name>1C Copilot - Core Tests</name>

    <!--
      These tests exercise real 1C:EDT BM and EMF APIs, so they need the target platform on the
      Surefire classpath. This is a plain jar module: it receives that platform only because Tycho
      injects the resolved platform of the eclipse-plugin module below, which happens only when
      com.codepilot1c.core is built in the same reactor invocation. The supported command is
      therefore:

        mvn -Dedt.home="<1C:EDT Eclipse dir>" -pl bundles/com.codepilot1c.core.tests -am package

      Dropping -am makes the module fail to compile; an environment that keeps the platform at
      compile time but loses it at test runtime is caught up front by
      com.codepilot1c.core.harness.OsgiTestPlatformAvailabilityTest instead of surfacing as
      NoClassDefFoundError across the suite.
    -->

    <dependencies>
        <dependency>
            <groupId>com.codepilot1c</groupId>
            <artifactId>com.codepilot1c.core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.codepilot1c</groupId>
            <artifactId>codepilot-runtime-kernel</artifactId>
            <version>${codepilot.runtime.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.13.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox-app</artifactId>
            <version>2.0.30</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testSourceDirectory>src</testSourceDirectory>
        <testResources>
            <testResource>
                <directory>src</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>25</release>
                    <testRelease>25</testRelease>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit47</artifactId>
                        <version>3.2.5</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <core.bundle.path>${project.basedir}/../com.codepilot1c.core/target/com.codepilot1c.core-${project.version}.jar</core.bundle.path>
                    </systemPropertyVariables>
                    <properties>
                        <property>
                            <name>listener</name>
                            <value>com.codepilot1c.core.harness.EquinoxTestRuntimeListener</value>
                        </property>
                    </properties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
