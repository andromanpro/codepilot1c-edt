<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<target name="1C Copilot Target Platform" sequenceNumber="10">
    <locations>
        <!--
            The exact materialized EDT 2026.2.0.289 closure supplies Eclipse,
            Xtext and com._1c.g5.v8.* bundles. Do not mix remote p2 versions.
            Supply its Eclipse directory with -Dedt.home=/path/to/Eclipse.
        -->
        <location path="${system_property:edt.home}" type="Directory"/>
    </locations>
    <targetJRE path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-17"/>
</target>
